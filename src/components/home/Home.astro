---
// The homepage: a bento grid. Each tile is one fact with a small scene of that work behind it;
// tiles with a + expand in place for the detail.
import { existsSync } from "node:fs"
import { getRelativeLocaleUrl } from "astro:i18n"
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import { parse } from "yaml"
import friendsSource from "../../data/friends.yaml?raw"
import BentoViz from "./BentoViz.astro"
import Tile from "./Tile.astro"
import "../../styles/global.css"
import { avatars, contacts, content, name, projects, stats, talks, type Locale } from "./content"

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = content[locale]
const other: Locale = locale === "zh" ? "en" : "zh"

const friends = parse(friendsSource) as {
  name: string
  description: string
  url: string
  avatar: string
}[]
/**
 * Tags an outbound link, so its site's analytics shows the visit came from this page, and from which part.
 * Other schemes, such as mailto:, stay as they are.
 */
const withUtm = (href: string, content: string, medium = "referral") => {
  const url = new URL(href)
  if (!url.protocol.startsWith("http")) return href
  url.searchParams.set("utm_source", "pan93.com")
  url.searchParams.set("utm_medium", medium)
  url.searchParams.set("utm_content", content)
  return url.href
}
/** The link as printed after its text: host and path, without the scheme, "www." or the query. */
const printUrl = (href: string) => {
  const url = new URL(href)
  return `${url.hostname.replace(/^www\./, "")}${url.pathname.replace(/\/$/, "")}`
}
const extraAvatars = avatars.filter((a) =>
  existsSync(new URL(`../../../public${a.src}`, import.meta.url)),
)

/** When the intro tile has room, the avatars sit in a 2×2 grid, in these cells. */
const gridSlots = [
  [1, 0],
  [0, 1],
  [1, 1],
]

/** Every non-ASCII character the pages can show, so Google Fonts serves only those CJK glyphs. */
const cjkText = [
  ...new Set(JSON.stringify({ content, friends, talks, projects, contacts, avatars, name })),
]
  .filter((c) => c.charCodeAt(0) > 0x7f)
  .sort()
  .join("")

const canonical = new URL(getRelativeLocaleUrl(locale), Astro.site)
const talkIcon = { slide: "presentation-chart", page: "calendar-dots", article: "article" }
const themeIcon = { system: "desktop", light: "sun", dark: "moon" } as const
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ecebe4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121411" media="(prefers-color-scheme: dark)" />
    <title>{name}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(getRelativeLocaleUrl("en"), Astro.site)} />
    <link rel="alternate" hreflang="zh-TW" href={new URL(getRelativeLocaleUrl("zh"), Astro.site)} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getRelativeLocaleUrl("en"), Astro.site)}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={name} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={content[other].ogLocale} />
    <meta property="og:image" content={new URL("/avatar.png", Astro.site)} />
    <meta property="og:image:alt" content={name} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Instrument+Serif&display=swap"
    />
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&text=${encodeURIComponent(cjkText)}&display=swap`}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      {t.ui.skip}
    </a>
    <main class="bento" id="main" tabindex="-1">
      <Tile surface="intro" class="intro">
        <nav class="intro__nav">
          <a
            class="intro__language"
            href={getRelativeLocaleUrl(other)}
            lang={content[other].lang}
            hreflang={content[other].lang}
          >
            <Icon name="ph:translate" />
            {t.ui.language}
          </a>
          <fieldset class="theme">
            <legend class="sr-only">{t.ui.theme}</legend>
            {(["system", "light", "dark"] as const).map((theme) => (
              <label class="theme__option" title={t.ui.themes[theme]}>
                <input
                  class="theme__input sr-only"
                  type="radio"
                  name="theme"
                  id={`theme-${theme}`}
                  value={theme}
                  checked={theme === "system"}
                />
                <span class="sr-only">{t.ui.themes[theme]}</span>
                <Icon name={`ph:${themeIcon[theme]}`} />
              </label>
            ))}
          </fieldset>
          <script is:inline>
            try {
              const theme = localStorage.getItem("theme")
              if (theme === "light" || theme === "dark")
                document.getElementById(`theme-${theme}`).checked = true
            } catch {}
          </script>
        </nav>
        <div class="avatars">
          <label class="avatars__stack">
            {extraAvatars.length > 0 && (
              <input class="avatars__toggle sr-only" type="checkbox" aria-label={t.ui.avatars} />
            )}
            {extraAvatars.map((a, i) => (
              <img
                class="avatars__image avatars__image--extra"
                src={a.src}
                alt={t.avatarAlts[a.alt]}
                width="88"
                height="88"
                style={`--n:${extraAvatars.length - i};--gx:${gridSlots[extraAvatars.length - i - 1][0]};--gy:${gridSlots[extraAvatars.length - i - 1][1]}`}
              />
            ))}
            <img class="avatars__image" src="/avatar.avif" alt={name} width="88" height="88" />
          </label>
        </div>
        <h1 class="intro__name" translate="no">
          {name}
        </h1>
        <p class="intro__role">{t.role}</p>
        <p class="intro__lead">{t.lead}</p>
        <ul class="stats">
          {stats.map((x) => (
            <li>
              <a class="stats__link" href={withUtm(x.url, "stats")}>
                <b class="stats__value">{x.value}</b>
                <span class="stats__label">
                  <span class="stats__icon">
                    <Icon name={`ph:${x.icon}`} />
                  </span>
                  {t.statLabels[x.key]}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </Tile>

      <Tile id="bt-now" label={t.ui.expand(t.ui.now)} class="now">
        <BentoViz kind="cluster" ui={t.ui} class="hide-when-open" />
        <h2 class="heading">
          <Icon name="ph:sun-horizon-duotone" class:list="heading__icon" />
          {t.ui.now}
        </h2>
        <ul class="now__list">
          {t.now.map((n) => (
            <li class="now__item">
              <Icon name={`ph:${n.icon}-duotone`} class:list="now__icon" />
              <div>
                <b class="now__title">{n.title}</b>
                <span class="now__role">
                  {n.role}
                  <em class="pill now__since">{n.since}</em>
                </span>
              </div>
            </li>
          ))}
        </ul>
        <div slot="more" class="now__more">
          <div>
            <h3 class="subheading">{t.ui.ossHeading}</h3>
            <ul class="repos">
              {t.nowDetail.oss.map((o) => (
                <li>
                  <a
                    class="repos__link"
                    href={withUtm(`https://github.com/zeabur-oss/${o.repo}`, "now")}
                    data-print-url={printUrl(`https://github.com/zeabur-oss/${o.repo}`)}
                  >
                    <b class="repos__title">
                      {o.title}
                      <Icon name="ph:arrow-up-right" class:list="repos__arrow" />
                    </b>
                    <p class="repos__text">{o.text}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="subheading">{t.ui.zeaburHeading(t.nowDetail.zeabur.length)}</h3>
            <ul class="chips">
              {t.nowDetail.zeabur.map((z) => (
                <li class="chips__chip">{z}</li>
              ))}
            </ul>
          </div>
        </div>
      </Tile>

      <Tile id="bt-talks" label={t.ui.expand(t.ui.talks)} surface="clay" class="stat">
        <BentoViz kind="wave" ui={t.ui} />
        <b class="stat__number">{talks.length}</b>
        <span>{t.ui.talks}</span>
        <p class="stat__note hide-when-open">
          {t.ui.latest}
          {talks[0].event} <span lang="zh-TW">{t.ui.quote(talks[0].title)}</span>
        </p>
        <ol slot="more" class="talks">
          {talks.map((talk) => (
            <li class="talks__item">
              <span class="talks__line">{talk.event}</span>
              <span class="talks__line" lang="zh-TW">
                {talk.title}
              </span>
              <span class="talks__links">
                {talk.links.map((l) => (
                  <a
                    class="talks__link"
                    href={withUtm(l.url, "talks")}
                    data-print-url={printUrl(l.url)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name={`ph:${talkIcon[l.kind]}`} />
                    {t.ui.talkLinks[l.kind]}
                  </a>
                ))}
              </span>
            </li>
          ))}
        </ol>
      </Tile>

      <Tile id="bt-l10n" label={t.ui.expand(t.ui.l10n)} surface="deep" class="stat">
        <BentoViz kind="rings" ui={t.ui} />
        <b class="stat__number">{new Date().getFullYear() - 2018}</b>
        <span>{t.ui.l10nYears}</span>
        <p class="stat__note hide-when-open">{t.ui.l10nNote}</p>
        <ul slot="more" class="ticks">
          {t.l10nDetail.map((l) => (
            <li class="ticks__item">{l}</li>
          ))}
        </ul>
      </Tile>

      <Tile id="bt-skills" label={t.ui.expand(t.ui.skills)} class="skills">
        <h2 class="heading">
          <Icon name="ph:toolbox-duotone" class:list="heading__icon" />
          {t.ui.skills}
        </h2>
        <ul class="skills__grid hide-when-open">
          {t.skills.map((s) => (
            <li class="skills__card">
              <Icon name={`ph:${s.icon}-duotone`} class:list="skills__icon" />
              {s.label}
              <span class="skills__tags">
                {s.tags.map((tag) => (
                  <small class="pill skills__tag">{tag}</small>
                ))}
              </span>
            </li>
          ))}
        </ul>
        <dl slot="more" class="skills__detail">
          {t.skills.map((s) => (
            <div>
              <dt class="skills__term">
                <Icon name={`ph:${s.icon}-duotone`} class:list="heading__icon" />
                {s.label}
              </dt>
              <dd class="skills__description">{s.detail}</dd>
            </div>
          ))}
        </dl>
      </Tile>

      <h2 class="heading projects-heading">
        <Icon name="ph:folders-duotone" class:list="heading__icon" />
        {t.ui.projects}
      </h2>
      {projects.map((p) => {
        const id = `bt-${p.key.replace(/\W+/g, "").toLowerCase()}`
        const copy = t.projects[p.key]
        return (
          <Tile id={id} label={t.ui.expand(p.key)} class="project" style={`--base:${p.color}`}>
            <BentoViz kind={p.viz} ui={t.ui} />
            <span class="project__tags">
              <Icon name={`ph:${p.icon}-duotone`} class:list="project__icon" />
              {p.tags.map((tag) => (
                <em class="project__tag">{tag}</em>
              ))}
            </span>
            <h3 class="project__name">{p.key}</h3>
            <p class="project__text">{copy.text}</p>
            <div slot="more">
              <ul class="ticks">
                {copy.detail.map((d) => (
                  <li class="ticks__item">{d}</li>
                ))}
              </ul>
              <a
                class="project__link"
                href={withUtm(p.url, "project")}
                data-print-url={printUrl(p.url)}
              >
                {t.ui.projectLink} <Icon name="ph:arrow-up-right" />
              </a>
            </div>
          </Tile>
        )
      })}

      <Tile id="bt-path" label={t.ui.expand(t.ui.path)} class="path" wide>
        <BentoViz kind="route" ui={t.ui} class="hide-when-open" />
        <h2 class="heading">
          <Icon name="ph:path-duotone" class:list="heading__icon" />
          {t.ui.path}
        </h2>
        <ol class="timeline">
          {t.timeline.map((step) => (
            <li class="timeline__step">
              <b class="timeline__year">{step.year}</b>
              {step.text}
            </li>
          ))}
        </ol>
        <table slot="more" class="experience">
          <tbody>
            {t.experiences.map((e) => (
              <tr class="experience__row">
                <td class="experience__when">{e.when}</td>
                <th class="experience__title">{e.title}</th>
                <td class="experience__role">{e.role}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </Tile>

      <Tile surface="sage">
        <BentoViz kind="orbit" ui={t.ui} />
        <h2 class="contact__heading">{t.ui.contact}</h2>
        <ul class="contact__links">
          {contacts.map((c) => (
            <li>
              <a
                class="contact__link"
                href={withUtm(c.url, "contact")}
                data-print-url={printUrl(c.url)}
                aria-label={c.name === "blog" ? t.blog : c.name}
              >
                <Icon name={`ph:${c.icon}-duotone`} />
              </a>
            </li>
          ))}
        </ul>
      </Tile>

      <Tile class="friends">
        <header class="friends__header">
          <h2 class="heading friends__heading">
            <Icon name="ph:users-three-duotone" class:list="heading__icon" />
            {t.ui.friends}
          </h2>
          <a
            class="friends__join"
            href={withUtm("https://link.pan93.com/friendship-links", "friends")}
          >
            {t.ui.friendsJoin}
          </a>
        </header>
        <ul class="friends__list">
          {friends.map((f) => (
            <li>
              <a
                class="friends__link"
                href={withUtm(f.url, "friends", "friend_link")}
                target="_blank"
                rel="noopener"
              >
                <Image
                  class="friends__avatar"
                  src={f.avatar}
                  alt=""
                  width={80}
                  height={80}
                  format={f.avatar.endsWith(".svg") ? "svg" : "avif"}
                />
                <span class="friends__text">
                  <b class="friends__name">{f.name}</b>
                  <small class="friends__description">{f.description}</small>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </Tile>
    </main>
  </body>
</html>

<script>
  // The theme switch works without this. It remembers the choice for the next visit.
  for (const input of document.querySelectorAll<HTMLInputElement>(".theme__input")) {
    input.addEventListener("change", () => {
      try {
        if (input.value === "system") localStorage.removeItem("theme")
        else localStorage.setItem("theme", input.value)
      } catch {}
    })
  }
</script>

<script>
  const token = import.meta.env.PUBLIC_POSTHOG_TOKEN
  const apiHost = import.meta.env.PUBLIC_POSTHOG_API_HOST
  const uiHost = import.meta.env.PUBLIC_POSTHOG_UI_HOST
  if (import.meta.env.PROD && token && apiHost && uiHost) {
    const { default: posthog } = await import("posthog-js")
    posthog.init(token, {
      api_host: apiHost,
      ui_host: uiHost,
      defaults: "2026-08-30",
      capture_pageview: true,
      capture_pageleave: true,
      person_profiles: "identified_only",
      disable_session_recording: true,
    })
  }
</script>

<style>
  body {
    min-height: 100dvh;
    padding: clamp(16px, 3vw, 40px);
    line-height: normal;
  }

  .skip {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 10;
    translate: 0 -200%;
    border-radius: 9999px;
    background-color: var(--color-ink);
    padding: 0.5rem 0.875rem;
    color: var(--color-paper);
    &:focus {
      translate: 0 0;
    }
  }

  .bento {
    margin-inline: auto;
    display: grid;
    max-width: 1240px;
    grid-auto-flow: row dense;
    grid-auto-rows: minmax(170px, auto);
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0.875rem;
    &:focus {
      outline: none;
    }
    @media (width >= 561px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    @media (width >= 901px) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Parts of a tile that only show while it is closed. */
  :global(.tile:has(> .tile__details[open])) .hide-when-open {
    display: none;
  }

  .heading {
    margin-bottom: 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-mute);
  }
  .heading__icon {
    font-size: 20px;
    color: var(--color-sage);
  }
  .subheading {
    margin-bottom: 0.75rem;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-mute);
  }
  .pill {
    border-radius: 9999px;
    padding: 0.25rem 0.4375rem;
    font-size: 11px;
    line-height: 1;
    color: var(--color-mute);
    font-style: normal;
  }
  .ticks {
    display: grid;
    gap: 0.5rem;
  }
  .ticks__item {
    position: relative;
    padding-left: 1.375rem;
    line-height: 1.7;
    &::before {
      content: "";
      position: absolute;
      top: 0.7em;
      left: 0.25rem;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 9999px;
      background-color: var(--tick);
    }
  }
  .intro__language:focus-visible {
    outline: 2px solid var(--color-sage);
    outline-offset: 2px;
  }

  /* Intro */
  .intro {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    @media (width >= 561px) {
      grid-column: span 2 / span 2;
      grid-row: span 2 / span 2;
    }
  }
  .intro__nav {
    position: absolute;
    top: 1.125rem;
    right: 1.125rem;
    display: flex;
    gap: 0.375rem;
  }
  .intro__language {
    display: inline-flex;
    height: 2.125rem;
    align-items: center;
    gap: 0.375rem;
    border-radius: 9999px;
    background-color: color-mix(in oklab, var(--color-ink) 7%, transparent);
    padding-inline: 0.75rem;
    font-size: 13px;
    &:hover {
      background-color: color-mix(in oklab, var(--color-ink) 13%, transparent);
    }
  }
  .intro__name {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    font-weight: 400;
  }
  .intro__role {
    margin-bottom: 0.625rem;
    font-weight: 500;
    color: var(--color-sage);
  }
  .intro__lead {
    max-width: 30em;
    line-height: 1.8;
  }

  /* The checked option's pill is one ::before that slides to it. */
  .theme {
    position: relative;
    display: flex;
    height: 2.125rem;
    gap: 0.125rem;
    border-radius: 9999px;
    background-color: color-mix(in oklab, var(--color-ink) 7%, transparent);
    padding: 0.1875rem;
    &::before {
      content: "";
      position: absolute;
      inset-block: 0.1875rem;
      left: 0.1875rem;
      width: 1.75rem;
      border-radius: 9999px;
      background-color: var(--color-tile);
      transition: translate 300ms var(--ease-fan);
    }
    &:has(#theme-light:checked)::before {
      translate: 1.875rem;
    }
    &:has(#theme-dark:checked)::before {
      translate: 3.75rem;
    }
  }
  .theme__option {
    position: relative;
    display: grid;
    width: 1.75rem;
    place-items: center;
    border-radius: 9999px;
    font-size: 15px;
    color: var(--color-mute);
    cursor: pointer;
    transition: color 300ms var(--ease-default);
    &:hover,
    &:has(:checked) {
      color: var(--color-ink);
    }
    &:has(:focus-visible) {
      outline: 2px solid var(--color-sage);
      outline-offset: 1px;
    }
  }

  /* The avatar area is a size container: the 2×2 grid adds a 100px row, used when the area is this tall. */
  .avatars {
    min-height: 5.5rem;
    flex: 1;
    container: avatars / size;
  }
  .avatars__stack {
    position: relative;
    display: block;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 9999px;
    &:has(:focus-visible) {
      outline: 2px solid var(--color-sage);
      outline-offset: 6px;
    }
  }
  .avatars__image {
    position: absolute;
    inset: 0;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 9999px;
    object-fit: cover;
  }
  .avatars__image--extra {
    scale: 0.9;
    transition-property: translate, rotate, scale;
    transition-duration: 350ms;
    transition-timing-function: var(--ease-fan);
    /* Hover, or a tap on a touch screen, spreads the avatars into a row with a 12px gap.
       :where() keeps these below the container query, so the 2×2 grid wins when there is room. */
    .avatars__stack:where(:has(:checked)) & {
      scale: 1;
      translate: calc(var(--n) * 100px) 0;
      rotate: calc(var(--n) * 4deg);
    }
    /* A tap leaves :hover on until the next tap elsewhere, which would keep the row open. */
    @media (hover: hover) {
      .avatars__stack:where(:hover) & {
        scale: 1;
        translate: calc(var(--n) * 100px) 0;
        rotate: calc(var(--n) * 4deg);
      }
    }
    @container avatars (min-height: 224px) {
      .avatars__stack & {
        scale: 1;
        translate: calc(var(--gx) * 100px) calc(var(--gy) * 100px);
        rotate: 0deg;
      }
    }
  }

  .stats {
