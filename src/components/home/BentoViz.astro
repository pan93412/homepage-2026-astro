---
import { Icon } from "astro-icon/components"

interface Props {
  kind: "years" | "names" | "shot" | "agent" | "speed"
  /** For "years": a count per year, oldest first. The last year is the current one. */
  years?: { year: number; count: number }[]
  /** For "names": the current names, then a line on the earlier ones, shown muted. */
  names?: string[]
  past?: string
  /** For "shot": a screen from the project, and the `object-position` that keeps its part that matters in view. */
  shot?: { src: string; position: string }
  /** For "agent": the agent's four steps, the third a failed build. For "speed": the caption, the fast run and the slow run. */
  labels?: string[]
  class?: string
}
const { kind, years = [], names = [], past = "", labels = [], shot, class: className } = Astro.props
const most = Math.max(1, ...years.map((y) => y.count))

// yolo-rs README, "Performance": YOLO11x, median ms per image on an M3 Max MacBook Pro.
const fast = 45
const slow = 322
---

<div class:list={["viz", `viz--${kind}`, className]} aria-hidden="true">
  {kind === "years" && (
    <div class="viz__chart">
      {years.map((y, i) => (
        <div class="viz__col" style={`--i:${i};--h:${y.count / most}`}>
          <span class="viz__count">{y.count || ""}</span>
          <span class="viz__column" />
          <span class="viz__year">{`’${String(y.year).slice(2)}`}</span>
        </div>
      ))}
    </div>
  )}
  {kind === "names" && (
    <>
      <ul class="viz__names">
        {names.map((n, i) => (
          <li class="viz__name" style={`--i:${i}`}>
            {n}
          </li>
        ))}
      </ul>
      <p class="viz__past" style={`--i:${names.length}`}>
        {past}
      </p>
    </>
  )}
  {kind === "shot" && shot && (
    <div class="viz__shot">
      <img
        src={shot.src}
        alt=""
        loading="lazy"
        decoding="async"
        style={`object-position:${shot.position}`}
      />
    </div>
  )}
  {kind === "agent" && (
    <ul class="viz__band viz__list">
      {labels.map((label, i) => (
        <li class="viz__check" style={`--i:${i}`}>
          {i === 2 ? (
            <Icon name="ph:x-bold" class:list="viz__tick viz__tick--fail" />
          ) : (
            <Icon name="ph:check-bold" class:list="viz__tick" />
          )}
          {label}
        </li>
      ))}
    </ul>
  )}
  {kind === "speed" && (
    <div class="viz__band viz__speed" style={`--fast:${fast / slow}`}>
      <p class="viz__ms">
        <b>{fast}</b> ms <span class="viz__caption">{labels[0]}</span>
      </p>
      <div class="viz__race">
        <span class="viz__lane">{labels[1]}</span>
        <span class="viz__track">
          <span class="viz__bar viz__bar--fast" />
        </span>
        <span class="viz__lane">{labels[2]}</span>
        <span class="viz__track">
          <span class="viz__bar viz__bar--slow" />
        </span>
      </div>
    </div>
  )}
</div>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        entry.target.setAttribute("data-seen", "")
        observer.unobserve(entry.target)
      }
    },
    { threshold: 0.5 },
  )
  for (const viz of document.querySelectorAll(".viz")) observer.observe(viz)
</script>

<style>
  .viz {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: -1;
    color: var(--viz);
    --reveal: 700ms;
    --step: 140ms;
  }
  :global(.tile:has(> .tile__details[open])) .viz {
    bottom: auto;
    height: 9.375rem;
  }

  @media screen and (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    .viz:not([data-seen]) {
      .viz__column {
        scale: 1 0;
      }
      .viz__bar {
        scale: 0 1;
      }
      .viz__count,
      .viz__name,
      .viz__check,
      .viz__shot,
      .viz__ms {
        opacity: 0;
        translate: 0 4px;
      }
    }
    .viz__column,
    .viz__name,
    .viz__check,
    .viz__shot,
    .viz__ms,
    .viz__count {
      transition-property: scale, opacity, translate;
      transition-duration: var(--reveal);
      transition-timing-function: var(--ease-spring);
      transition-delay: calc(var(--i, 0) * var(--step));
    }
    .viz__count {
      transition-delay: calc(var(--i) * var(--step) + 500ms);
    }
    .viz__check {
      --step: 280ms;
    }
    /* 45 ms and 322 ms, each × 7. */
    .viz__bar {
      transition: scale linear;
      transition-delay: 400ms;
    }
    .viz__bar--fast {
      transition-duration: 315ms;
    }
    .viz__bar--slow {
      transition-duration: 2254ms;
    }
  }

  .viz--years,
  .viz--names {
    position: relative;
    flex: 1;
    min-height: 4rem;
    margin: 0 2.75rem 1.5rem 0;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    :global(.tile:has(> .tile__details[open])) & {
      position: absolute;
      inset: 1.375rem 4rem auto 1.375rem;
      height: 6.5rem;
      margin: 0;
    }
  }
  :global(.tile:has(> .tile__details[open])) .viz--names {
    position: relative;
    inset: auto;
    height: auto;
    contain: none;
    flex: 1;
    margin: 0 3rem 1.75rem 0;
  }
  .viz__chart {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    height: 100%;
    border-bottom: 1px solid color-mix(in oklab, currentcolor 30%, transparent);
    padding-bottom: 0;
  }
  .viz__col {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    max-width: 2rem;
  }
  .viz__column {
    width: 100%;
    height: calc(var(--h) * (100% - 1.25rem));
    min-height: 2px;
    transform-origin: bottom;
    border-radius: 4px 4px 0 0;
    background-color: color-mix(in oklab, currentcolor 45%, transparent);
    .viz__col:last-child & {
      background-color: currentcolor;
    }
  }
  .viz__count {
    margin-bottom: 0.375rem;
    opacity: 0.8;
  }
  .viz__year {
    position: absolute;
    top: calc(100% + 0.5rem);
    opacity: 0.7;
  }
  .viz--names {
    /* A taller row would switch the avatars tile to its 2×2 layout. */
    contain: size;
    overflow: hidden;
    margin-right: 0;
    font-family: var(--font-sans);
  }
  .viz__names {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    /* Clear of the + button; the line under the chips runs below it, to the tile's padding. */
    margin-right: 2.75rem;
  }

  .viz__name {
    display: inline-flex;
    align-items: center;
    height: 1.5rem;
    border-radius: 4px;
    padding: 0 0.375rem;
    background-color: var(--viz);
    font-size: 12px;
    line-height: 1;
    color: var(--color-tile);
    :global(.tile:has(> .tile__details[open])) & {
      height: 2rem;
      padding: 0 0.75rem;
      font-size: 15px;
    }
  }
  .viz__past {
    margin-top: 0.5rem;
    font-size: 12px;
    line-height: 1.5;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--color-mute);
    :global(.tile:has(> .tile__details[open])) & {
      margin-top: 0.75rem;
      font-size: 15px;
      -webkit-line-clamp: none;
    }
  }

  .viz__band {
    position: absolute;
    top: 1.375rem;
    right: 4rem;
    left: 1.375rem;
    transform-origin: top left;
    transition: scale 500ms var(--ease-spring);
    @media (width >= 561px) {
      :global(.tile:has(> .tile__details[open])) & {
        scale: 1.3;
        /* Undoes the scale, so the scene keeps its insets. */
        right: auto;
        width: calc((100% - 5.375rem) / 1.3);
      }
    }
  }
  .viz__list {
    display: grid;
    gap: 0.5rem;
    font-size: 13px;
    line-height: 1;
  }
  .viz__check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 1.125rem;
  }
  .viz__tick {
    display: grid;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    padding: 3px;
    border-radius: 4px;
    background-color: var(--c);
    color: var(--color-tile);
  }
  .viz__tick--fail {
    outline: 1.5px solid var(--c);
    outline-offset: -1.5px;
    background-color: transparent;
    color: var(--c);
  }

  /* The whole screen fills the tile and fades out above the text. */
  .viz__shot {
    position: absolute;
    inset: 0;
    mask-image: linear-gradient(to bottom, #000 20%, transparent 60%);
    :global(.tile:has(> .tile__details[open])) & {
      mask-image: linear-gradient(to bottom, #000 40%, transparent);
    }
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .viz__ms {
    font-size: 13px;
    color: var(--color-mute);
    b {
      font-size: 36px;
      font-weight: 500;
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.03em;
      line-height: 1;
      color: var(--c);
    }
  }
  .viz__caption {
    margin-left: 0.25rem;
  }
  .viz__race {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.375rem 0.625rem;
    margin-top: 0.625rem;
    font-size: 12px;
    color: var(--color-mute);
  }
  .viz__track {
    display: block;
    height: 0.5rem;
  }
  .viz__bar {
    display: block;
    height: 100%;
    transform-origin: left;
    border-radius: 2px;
  }
  .viz__bar--fast {
    width: calc(var(--fast) * 100%);
    background-color: var(--c);
  }
  .viz__bar--slow {
    background-color: color-mix(in oklab, var(--c) 25%, transparent);
  }
</style>
