---
import { messages, type Locale } from "../i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = messages[locale]
const slides = [
  {
    conferenceName: "COSCUP 2026",
    slideTitle: "Git 繁體中文翻譯流程治理實戰",
    links: [
      {
        name: t.slides.slide,
        url: "https://static.pan93.com/presentations/git-localization-workflow.pdf",
      },
      { name: "COSCUP", url: "https://coscup.org/2026/session/NSFLQL" },
    ],
  },
  {
    conferenceName: "CNTUG Meetup #72",
    slideTitle: "Zeabur 與共享叢集的奮鬥史",
    links: [{ name: "CNTUG", url: "https://ocgroups.dev/cncf/group/q7hxb6g/event/9d4k6sz" }],
  },
  {
    conferenceName: "SITCON 2026",
    slideTitle: "從頭製作酷炫的 Grafana 儀表板",
    links: [
      { name: t.slides.slide, url: "https://www.figma.com/deck/O8BwdzmRUfedbq0s8w7gm8" },
      { name: "SITCON", url: "https://sitcon.org/2026/agenda/077a7f/" },
    ],
  },
  {
    conferenceName: "MOPCON 2025",
    slideTitle: "帳號驗證機制怎麼噴掉5萬元 (Lightning Talk)",
    links: [{ name: t.slides.slide, url: "https://link.pan93.com/mopcon-2025-lightning-talk" }],
  },
  {
    conferenceName: "Cursor Meetup Taipei (June 2025)",
    slideTitle: "Vibe in the efficient way",
    links: [{ name: t.slides.slide, url: "https://link.pan93.com/cursor-meetup-202506-slide" }],
  },
  {
    conferenceName: "SITCON 2025",
    slideTitle: "選課卡成狗？微服務架構帶你翻轉校園系統",
    links: [
      { name: t.slides.slide, url: "https://link.pan93.com/sitcon2025-ppt" },
      { name: "SITCON", url: "https://sitcon.org/2025/agenda/a03517/" },
      { name: t.slides.article, url: "https://blog.pan93.com/tags/sitcon-2025/" },
    ],
  },
  {
    conferenceName: "MOPCON 2024",
    slideTitle: "導入可監控性：OpenTelemetry實踐和Request ID實作",
    links: [
      { name: t.slides.slide, url: "https://link.pan93.com/opentelemetry-ppt" },
      { name: "MOPCON", url: "https://mopcon.org/2024/speaker/?id=2024010" },
    ],
  },
  {
    conferenceName: "PyCon 2024",
    slideTitle: "如何將Python程式碼的環境遷移到其他地方？",
    links: [
      { name: t.slides.article, url: "https://blog.pan93.com/posts/move-venv-to-other-machines/" },
      {
        name: t.slides.slide,
        url: "https://www.figma.com/community/file/1457614794408994979/pycon-presentation-how-to-make-a-python-environment-recreatable",
      },
      { name: "PyCon", url: "https://tw.pycon.org/2024/zh-hant/conference/talk/319" },
    ],
  },
  {
    conferenceName: "DevFest 2022",
    slideTitle: "透過重構實戰，探索Web App DX和UX的最佳做法",
    links: [
      { name: t.slides.slide, url: "https://1drv.ms/b/s!AiC-9Gl0ltrahdo4tp-3GQz7FFiYxw?e=xM4dXd" },
      {
        name: "GDG",
        url: "https://gdg.community.dev/events/details/google-gdg-kaohsiung-presents-devfest-kaohsiung-tainan-2022/",
      },
    ],
  },
  {
    conferenceName: "MOPCON 2021",
    slideTitle: "應到未到，一看就知道！",
    links: [
      { name: t.slides.slide, url: "https://imych.one/mopcon2021p" },
      { name: "MOPCON", url: "https://mopcon.org/2021/schedule/2021039" },
    ],
  },
]
---

<section aria-labelledby="slides">
  <h2 id="slides">{t.slides.title}</h2>
  <ul class="mb-1.5 list-inside list-disc [&>li]:mb-0.5">
    {slides.map((slide) => (
      <li>
        <strong>{slide.conferenceName}</strong>
        {t["description-list"].colon}
        {slide.slideTitle}
        <span class="whitespace-pre-wrap">
          <span aria-hidden="true">{t["inline-links"].parenthesis}</span>
          {slide.links.map((link, index) => (
            <>
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.name}
              </a>
              {index < slide.links.length - 1 && (
                <span aria-hidden="true">{t["inline-links"].separator}</span>
              )}
            </>
          ))}
          <span aria-hidden="true">{t["inline-links"]["parenthesis-end"]}</span>
        </span>
      </li>
    ))}
  </ul>
</section>
