---
// Decorative background scene for a bento tile. Each kind draws what that work is about.
import { Icon } from "astro-icon/components"
import type { Content } from "./content"
interface Props {
  ui: Content["ui"]
  kind:
    | "bootstrap"
    | "diff"
    | "pipeline"
    | "detect"
    | "cluster"
    | "wave"
    | "rings"
    | "route"
    | "orbit"
  class?: string
}
const { kind, ui, class: className } = Astro.props
const waveBars = Array.from(
  { length: 28 },
  (_, i) => 0.25 + 0.75 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.6)),
)
const rings = Array.from({ length: 8 }, (_, i) => 18 + i * 13)
const hex = (x: number, y: number, r: number) =>
  Array.from({ length: 6 }, (_, i) => {
    const a = (Math.PI / 3) * i + Math.PI / 6
    return `${(x + r * Math.cos(a)).toFixed(1)},${(y + r * Math.sin(a)).toFixed(1)}`
  }).join(" ")
// yolo-rs README, "Performance": median ms on an M3 Max MacBook Pro.
const timings = [
  { model: "YOLOv8x", coreml: 28, cpu: 374 },
  { model: "YOLO11x", coreml: 45, cpu: 322 },
  { model: "YOLO12x", coreml: 164, cpu: 373 },
  { model: "YOLO26x", coreml: 47, cpu: 345 },
]
const stroke = "stroke-(--c) stroke-[1.2]"
const grow = "origin-top-left transition-[scale] duration-300 sm:group-data-open/tile:scale-140"
---

<div
  class:list={[
    "pointer-events-none absolute inset-0 -z-1 text-(--viz)",
    kind !== "rings" && "group-data-open/tile:bottom-auto group-data-open/tile:h-37.5",
    "motion-reduce:**:animate-none!",
    className,
  ]}
  aria-hidden="true"
>
  {kind === "bootstrap" && (
    <svg class="absolute top-5.5 left-5.5 w-[calc(100%-96px)] max-w-65" viewBox="0 0 220 110">
      <rect class:list={[stroke, "fill-(--c)/10"]} x="8" y="22" width="62" height="66" rx="6" />
      {[40, 55, 70].map((y) => (
        <line class:list={[stroke, "opacity-60"]} x1="18" y1={y} x2="52" y2={y} />
      ))}
      <circle class="animate-blink fill-(--c)" cx="60" cy="40" r="2.5" />
      <path class:list={[stroke, "animate-dash [stroke-dasharray:4_4]"]} d="M78 55 H118" />
      {[
        [146, 30],
        [190, 30],
        [146, 80],
        [190, 80],
        [168, 55],
      ].map(([x, y], i) => (
        <polygon
          class:list={[stroke, "origin-center animate-grow fill-(--c)/18 [transform-box:fill-box]"]}
          style={`--i:${i}`}
          points={hex(x, y, i === 4 ? 15 : 12)}
        />
      ))}
    </svg>
  )}
  {kind === "diff" && (
    <div
      class:list={[
        grow,
        "absolute top-5.5 right-16 left-5.5 grid gap-0.75 font-mono text-[11px] leading-[1.7]",
      ]}
    >
      {[
        { m: " ", k: "service", v: "web" },
        { m: "-", k: "image", v: "main-a1b2c3" },
        { m: "+", k: "image", v: "main-3e1a9c" },
        { m: "+", k: "domain", v: "app.example.com" },
      ].map((r, i) => (
        <div
          class:list={[
            "grid animate-row-in grid-cols-[14px_auto_1fr] gap-2 rounded-sm px-2",
            r.m === "+" && "bg-sage/16 text-ink",
            r.m === "-" && "bg-clay/16 text-mute line-through decoration-clay/60",
            r.m === " " && "text-mute",
          ]}
          style={`--i:${i}`}
        >
          <span class:list={[r.m === "+" && "text-sage", r.m === "-" && "text-clay"]}>{r.m}</span>
          <span class="text-(--c)">{r.k}</span>
          <span class="truncate">{r.v}</span>
        </div>
      ))}
    </div>
  )}
  {kind === "pipeline" && (
    <div class:list={[grow, "absolute top-4.5 right-5.5 left-5.5"]}>
      <div class="relative flex max-w-[min(240px,calc(100%-42px))] items-center justify-between before:absolute before:top-1/2 before:right-5 before:left-1.75 before:h-0.5 before:-translate-y-1/2 before:bg-(--c)/30">
        {[0, 1, 2, 3].map((i) => (
          <span
            class="relative size-3.5 animate-fill rounded-full border-2 border-(--c) bg-tile"
            style={`--i:${i}`}
          />
        ))}
        <span class="relative grid size-8.5 place-items-center rounded-[9px] bg-(--c) text-[19px] text-tile">
          <Icon name="ph:package-duotone" />
        </span>
      </div>
      <p class="mt-3 truncate text-[12px] leading-normal text-[color-mix(in_oklab,var(--c)_75%,var(--color-tile))]">
        <b class="font-semibold text-(--c)">AI Agent</b> {ui.pipeline}
      </p>
    </div>
  )}
  {kind === "detect" && (
    <div
      class:list={[
        grow,
        "absolute top-5 right-16 left-5.5 grid gap-1.25 font-mono text-[11px] leading-[1.4] text-mute",
      ]}
    >
      <p class="mb-0.5 flex gap-3">
        M3 Max
        <span class="inline-flex items-center gap-1.25 before:size-2 before:rounded-[2px] before:bg-(--c)">
          CoreML
        </span>
        <span class="inline-flex items-center gap-1.25 before:size-2 before:rounded-[2px] before:bg-(--c)/22">
          CPU
        </span>
      </p>
      {timings.map((t, i) => (
        <div
          class="grid grid-cols-[7ch_1fr_6ch] items-center gap-2"
          style={`--i:${i};--coreml:${t.coreml / 400};--cpu:${t.cpu / 400}`}
        >
          <span class="text-ink">{t.model}</span>
          <span class="relative h-2">
            <span class="absolute inset-y-0 left-0 w-[calc(var(--cpu)*100%)] origin-left animate-bar rounded-[2px] bg-(--c)/22" />
            <span class="absolute inset-y-0 left-0 w-[calc(var(--coreml)*100%)] origin-left animate-bar rounded-[2px] bg-(--c)" />
          </span>
          <span class="text-right text-(--c)">{t.coreml} ms</span>
        </div>
      ))}
    </div>
  )}
  {kind === "cluster" && (
    <svg class="absolute -right-2.5 -bottom-2.5 w-[62%] opacity-55" viewBox="0 0 240 160">
      <path
        class="fill-none stroke-current stroke-1 [stroke-dasharray:3_4]"
        d="M60 40 L120 80 L190 45 M120 80 L80 130 M120 80 L175 125 M190 45 L175 125 M60 40 L80 130"
      />
      {[
        [60, 40],
        [190, 45],
        [80, 130],
        [175, 125],
      ].map(([x, y], i) => (
        <g style={`--d:${i * 0.6}s`}>
          <polygon class="fill-current/10 stroke-current stroke-[1.2]" points={hex(x, y, 16)} />
          <circle class="animate-blink-node fill-current" cx={x} cy={y} r="4" />
        </g>
      ))}
      <polygon class="fill-current/22 stroke-current stroke-[1.2]" points={hex(120, 80, 22)} />
      <circle class="animate-blink-node fill-current" cx="120" cy="80" r="6" />
      <circle class="fill-clay motion-reduce:hidden" r="3">
        <animateMotion dur="3.2s" repeatCount="indefinite" path="M60 40 L120 80 L175 125" />
      </circle>
      <circle class="fill-clay motion-reduce:hidden" r="3">
        <animateMotion
          dur="2.6s"
          begin="1s"
          repeatCount="indefinite"
          path="M190 45 L120 80 L80 130"
        />
      </circle>
    </svg>
  )}
  {kind === "wave" && (
    <div class="absolute top-5.5 right-5.5 left-5.5 flex h-[44%] items-end gap-0.75 opacity-40">
      {waveBars.map((h, i) => (
        <span
          class="h-[calc(var(--h)*100%)] flex-1 origin-bottom animate-eq rounded-[2px] bg-current"
          style={`--h:${h};--d:${(i % 7) * 0.12}s`}
        />
      ))}
    </div>
  )}
  {kind === "rings" && (
    <svg class="absolute top-0 right-0 size-[max(240px,min(100%,360px))]" viewBox="0 0 240 240">
      {rings.map((r, i) => (
        <circle
          class="animate-blink-ring fill-none stroke-current stroke-1 opacity-18"
          cx="200"
          cy="40"
          r={r}
          style={`--d:${i * 0.15}s`}
        />
      ))}
      <defs>
        <path id="ring-path" d="M200 40 m-96 0 a96 96 0 1 0 192 0 a96 96 0 1 0 -192 0" />
      </defs>
      <text class="fill-current text-[9px] tracking-[0.12em] opacity-50">
        <textPath href="#ring-path">{`Git · GNOME · KDE · Telegram · Weblate · ${ui.l10nRing} · `}</textPath>
      </text>
    </svg>
  )}
  {kind === "route" && (
    <svg
      class="absolute inset-x-0 bottom-0 h-[70%] w-full"
      viewBox="0 0 1000 120"
      preserveAspectRatio="none"
    >
      <path
        class="animate-dash-slow fill-none stroke-sage stroke-[1.5] opacity-35 [stroke-dasharray:6_6]"
        d="M0 90 C 120 20, 220 110, 340 60 S 560 10, 680 70 S 880 100, 1000 30"
      />
    </svg>
  )}
  {kind === "orbit" && (
    <svg class="absolute -right-10 -bottom-10 w-[110%]" viewBox="0 0 200 200">
      {[40, 70, 100].map((r) => (
        <circle class="fill-none stroke-current opacity-20" cx="150" cy="150" r={r} />
      ))}
      <circle
        class="origin-[150px_150px] animate-orbit fill-current opacity-70"
        cx="150"
        cy="80"
        r="5"
      />
      <circle
        class="origin-[150px_150px] animate-orbit-slow fill-current opacity-70"
        cx="50"
        cy="150"
        r="4"
      />
      <circle
        class="origin-[150px_150px] animate-orbit-fast fill-current opacity-70"
        cx="150"
        cy="110"
        r="3"
      />
    </svg>
  )}
</div>
