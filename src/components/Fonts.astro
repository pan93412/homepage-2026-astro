---
/**
 * Geist covers ASCII. LINE Seed TW covers the rest, cut by the build to the characters the pages
 * use (src/integrations/subset-fonts.ts). The faces are inline, so Vite does not try to resolve
 * files that exist only after the build.
 */
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&display=swap"
/>
<style is:inline>
  @font-face {
    font-family: "LINE Seed TW";
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/line-seed-tw-400.woff2") format("woff2");
  }
  @font-face {
    font-family: "LINE Seed TW";
    font-weight: 700;
    font-display: swap;
    src: url("/fonts/line-seed-tw-700.woff2") format("woff2");
  }
</style>
