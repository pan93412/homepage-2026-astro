# Public PostHog project token, not a personal API key.
# Leave these blank to disable PostHog. Development never sends events.
PUBLIC_POSTHOG_TOKEN=

# Full URL of your provisioned reverse proxy, e.g. https://e.yourdomain.com
PUBLIC_POSTHOG_API_HOST=

# PostHog app URL: https://us.posthog.com or https://eu.posthog.com
PUBLIC_POSTHOG_UI_HOST=
