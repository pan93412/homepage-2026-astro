---
// A bento tile. With an id it opens in place, as one of an exclusive <details> group, and shows the "more" slot.
import { Icon } from "astro-icon/components"

interface Props {
  id?: string
  /** Screen-reader text of the + button. */
  label?: string
  surface?: "tile" | "intro" | "clay" | "deep" | "sage"
  /** Take the full row while open. */
  wide?: boolean
  class?: string
  style?: string
}

const { id, label, surface = "tile", wide = false, class: className, style } = Astro.props
const onColor = surface !== "tile" && surface !== "intro"
---

<section
  id={id}
  class:list={[
    "tile",
    `tile--${surface}`,
    id && "tile--expandable",
    wide && "tile--wide",
    className,
  ]}
  style={id ? `view-transition-name:${id};${style ?? ""}` : style}
>
  <slot />
  {id && (
    <details class:list={["tile__details", onColor && "tile__details--on-color"]} name="tile">
      <summary class="tile__summary">
        <span class="tile__toggle">
          <span class="sr-only">{label}</span>
          <Icon name="ph:plus" />
        </span>
      </summary>
      <div class="tile__more">
        <slot name="more" />
      </div>
    </details>
  )}
</section>

<script>
  // The tiles open and close without this script. It adds the morph between layouts,
  // closing with Escape or a click outside the tile, and scrolls an opened tile into view.
  // The open tile is also in the URL hash, so Back closes it and a link can open one.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)")

  const detailsFor = (id: string) =>
    id
      ? document.getElementById(id)?.querySelector<HTMLDetailsElement>(":scope > .tile__details")
      : null

  const setOpen = (details: HTMLDetailsElement, open: boolean) => {
    const apply = () => {
      details.open = open
    }
    const done = () =>
      open &&
      details.parentElement?.scrollIntoView({
        block: "nearest",
        behavior: reduce.matches ? "auto" : "smooth",
      })
    if (document.startViewTransition && !reduce.matches) {
      const transition = document.startViewTransition(apply)
      transition.ready.catch(() => {})
      transition.finished.then(done, done)
    } else {
      apply()
      done()
    }
  }

  // One history entry stands for "a tile is open": switching tiles replaces it, and closing goes back past it.
  const toggle = (details: HTMLDetailsElement, open: boolean) => {
    const pushed = history.state?.tile === true
    if (open) {
      const url = `#${details.parentElement!.id}`
      if (pushed) history.replaceState({ tile: true }, "", url)
      else history.pushState({ tile: true }, "", url)
      setOpen(details, true)
    } else if (pushed) {
      history.back()
    } else {
      history.replaceState(null, "", location.pathname + location.search)
      setOpen(details, false)
    }
  }

  addEventListener("popstate", () => {
    const target = detailsFor(location.hash.slice(1))
    const open = document.querySelector<HTMLDetailsElement>(".tile__details[open]")
    // A link to a tile's hash adds an entry without our state; mark it so the tile closes by going back.
    if (target && history.state === null) history.replaceState({ tile: true }, "")
    if (target && !target.open) setOpen(target, true)
    else if (!target && open) setOpen(open, false)
  })

  const linked = detailsFor(location.hash.slice(1))
  if (linked) {
    // Put an entry without the hash under the linked tile, so it is closed and switched like one opened here.
    if (history.state?.tile !== true) {
      history.replaceState(null, "", location.pathname + location.search)
      history.pushState({ tile: true }, "", `#${linked.parentElement!.id}`)
    }
    linked.open = true
    linked.parentElement!.scrollIntoView({ block: "nearest" })
  }

  document.addEventListener("click", (event) => {
    const target = event.target as Element
    const details = target.closest(".tile__summary")?.parentElement
    if (details instanceof HTMLDetailsElement) {
      event.preventDefault()
      toggle(details, !details.open)
      return
    }
    const open = document.querySelector<HTMLDetailsElement>(".tile__details[open]")
    // A drag that selects text ends in a click on the common ancestor; keep the tile open for it.
    if (open && !open.parentElement?.contains(target) && getSelection()?.isCollapsed !== false)
      toggle(open, false)
  })

  addEventListener("keydown", (event: KeyboardEvent) => {
    if (event.key !== "Escape") return
    const open = document.querySelector<HTMLDetailsElement>(".tile__details[open]")
    if (!open) return
    toggle(open, false)
    open.querySelector<HTMLElement>(".tile__summary")?.focus()
  })
</script>

<style>
  .tile {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-tile);
    padding: 1.375rem;
  }
  .tile--tile {
    background-color: var(--color-tile);
  }
  .tile--intro {
    background-color: var(--color-intro);
  }
  .tile--clay {
    background-color: var(--color-clay-tile);
    color: #fff8f0;
    --viz: #fff8f0;
  }
  .tile--deep {
    background-color: var(--color-deep-tile);
    color: #fff8f0;
    --viz: #e9efe2;
  }
  .tile--sage {
    background-color: var(--color-sage-tile);
    color: #f3f6ef;
    --viz: #f3f6ef;
  }

  .tile--expandable {
    transition-property: box-shadow, translate;
    transition-duration: 250ms;
    transition-timing-function: var(--ease-default);
    &:not(:has(> .tile__details[open])):hover {
      translate: 0 -0.1875rem;
      box-shadow: var(--lift);
    }
    &:has(> .tile__details[open]) {
      box-shadow: var(--lift);
      @media (width >= 561px) {
        grid-column: span 2 / span 2;
        grid-row: span 2 / span 2;
      }
    }
  }
  .tile--wide:has(> .tile__details[open]) {
    grid-column: 1 / -1;
    grid-row: auto;
  }

  .tile__summary {
    display: block;
    list-style: none;
    cursor: pointer;
    user-select: none;
    &::-webkit-details-marker {
      display: none;
    }
    &:focus-visible {
      outline: none;
    }
    /* A closed tile opens from a click anywhere on it. */
    &::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
    }
    .tile__details[open] > &::after {
      display: none;
    }
  }

  .tile__toggle {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 9999px;
    font-size: 16px;
    background-color: color-mix(in oklab, var(--color-ink) 6%, transparent);
    transition-property: rotate, background-color;
    transition-duration: 300ms;
    transition-timing-function: var(--ease-default);
    &:hover {
      background-color: color-mix(in oklab, var(--color-ink) 12%, transparent);
    }
    .tile__details--on-color & {
      background-color: rgb(255 255 255 / 0.16);
    }
    .tile__details--on-color &:hover {
      background-color: rgb(255 255 255 / 0.24);
    }
    .tile__summary:focus-visible & {
      outline: 2px solid var(--color-sage);
      outline-offset: 2px;
    }
    .tile__details[open] & {
      rotate: 45deg;
    }
  }

  .tile__more {
    margin-top: 1.375rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in oklab, var(--color-ink) 10%, transparent);
    animation: rise 0.45s 0.1s both;
    .tile__details--on-color & {
      border-top-color: rgb(255 255 255 / 0.15);
    }
  }
</style>
