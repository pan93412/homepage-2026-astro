---
import { messages, type Locale } from "../i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = messages[locale]
const contacts = [
  { name: "GitHub", handle: "pan93412", url: "https://github.com/pan93412" },
  { name: "Threads", handle: "@pan93412", url: "https://www.threads.net/@pan93412" },
  { name: "Twitter (X)", handle: "@byStarTW", url: "https://x.com/byStarTW" },
  { name: "Telegram", handle: "@bystartw_chan", url: "https://t.me/bystartw_chan" },
  {
    name: "Mastodon",
    handle: "@pan93412@social.slat.org",
    url: "https://social.slat.org/@pan93412",
  },
  { name: "Bluesky", handle: "@pan93.com", url: "https://bsky.app/profile/pan93.com" },
  { name: "Facebook", handle: "Yi-Jyun Pan", url: "https://facebook.com/pan93412TW" },
  { name: "LinkedIn", handle: "pan93412", url: "https://www.linkedin.com/in/pan93412/" },
  { name: "Figma", handle: "pan93412", url: "https://www.figma.com/u/pan93412" },
]
---

<section class="@container" aria-labelledby="social-media">
  <h2 id="social-media">{t["social-media"].title}</h2>
  <p>{t["social-media"].description}</p>
  <div class="mt-2 grid grid-cols-1 gap-2 @lg:grid-cols-2 @xl:grid-cols-3">
    {contacts.map((contact) => (
      <div>
        <strong>{contact.name}</strong>:&nbsp;
        <br class="hidden @lg:block" />
        <a href={contact.url}>{contact.handle}</a>
      </div>
    ))}
  </div>
</section>
